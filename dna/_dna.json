{
  // This package is a DNA layer: dna/ is authored by hand and is the last
  // layer of its own instantiation. "role": "dna" is also what makes this
  // package usable as a layer at all — a dna/ folder alone does not.
  "version": 1,
  "role": "dna",

  // The parent DNAs. dna_install brings the install overview this layer
  // extends with the gg install guides, dna_index the index conventions
  // every gg repo follows. Parents first, this layer wins.
  "layers": ["dna_install", "dna_index"]
}
